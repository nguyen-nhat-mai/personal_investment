# Copy this file to docker/.env and fill in before running `docker compose up`.
# docker/.env is gitignored - never commit it.

# --- GCP / BigQuery ---
GCP_PROJECT=your-gcp-project-id
# Path (relative to docker/, or absolute) to the downloaded service-account JSON key.
# The service account needs BigQuery Data Editor + BigQuery Job User roles.
# Put the key at docker/keys/gcp-service-account.json (that folder is gitignored).
GCP_KEY_PATH=./keys/gcp-service-account.json

# --- DVF ingestion ---
# Years to pull per department. Full DVF history starts 2014; keep this small at first -
# each extra year multiplies download time across ~93 departments (DVF excludes Alsace-Moselle:
# see dags/include/dvf.py).
DVF_YEARS=2020,2021,2022,2023,2024

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_WEBSERVER_SECRET_KEY=
